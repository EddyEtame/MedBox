# --- Workshop material: NEVER commit these ---
*.pdf
*.pptx
*.docx
Workshop*/
docs/material/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- MedBox runtime state ---
data/
*.db
*.db-journal
*.db-wal
recordings/
*.medbox

# --- Models (huge, pulled by setup) ---
models/
*.gguf

# --- Installers setup.py downloads into this folder ---
# The pinned Ollama installer is 1.22 GB and lands in the repo root. Untracked
# it merely clutters `git status`; committed, GitHub rejects the push for
# exceeding the 100 MB blob limit, which is a confusing way to find out.
OllamaSetup.exe
*.exe
# The download is staged under this name until it is complete. A Ctrl+C in
# the middle used to leave up to 1.2 GB of it here, untracked and unignored.
*.part

# --- Internal notes: audits, research, decisions. Never on GitHub. ---
.research/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- .NET launcher build output (70 MB of runtime DLLs); the source is what is versioned ---
launcher/**/bin/
launcher/**/obj/

# --- Build inputs and outputs: portable bundle, installers, wheelhouse, logs. Never on GitHub. ---
.build/
